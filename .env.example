# Synthetic placeholders only. Copy to ./.env and chmod 600 (any OS),
# or use the platform's private Jirust config directory documented in README.
# Real dotenv files are git-ignored; never paste tokens in commands or chat.
JIRA_URL=https://example.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=replace-with-your-api-token-without-scopes
JIRA_PROJECT=DEV
JIRA_PREFIX=DEV
JIRA_BOARD_ID=17
JIRA_JQL=
JIRA_BACKEND=acli
JIRA_CLI_BIN=
JIRA_READ_ONLY=false
JIRA_NO_CACHE=false
JIRA_LIMIT=500
JIRA_ATTACHMENT_DIR=
JIRA_IMAGE_PROTOCOL=auto

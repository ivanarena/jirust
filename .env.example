# Synthetic examples only. Copy to ./.env (or the private Jirust config directory)
# and chmod 600. Real dotenv files are git-ignored. Never paste tokens in argv/chat.
# For a named profile: jirust --env-file /private/path/work.env
# or export JIRUST_ENV_FILE=/private/path/work.env (a path, never a token).

# Optional explicit token authentication: supply ALL THREE together, or leave all
# empty to reuse your existing CLI login. HTTPS Atlassian Cloud origins only.
# Example URL: https://example.atlassian.net; email: you@example.com.
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Optional browser/clipboard-only base, e.g. https://example.atlassian.net
# or https://jira.example.org/jira. No credentials/query/fragment; omit /browse/KEY.
# This is NOT an API endpoint and never receives Jira authentication.
# Empty: use the pinned CLI/Board site, or the ticket's own site/context.
JIRA_BROWSE_URL=

# Set your own project. Empty prefix follows the project automatically.
JIRA_PROJECT=DEV
JIRA_PREFIX=
# Set your actual numeric Board ID for authoritative Board/Backlog membership.
# Example: 17. Empty disables the opt-in bridge (unless already saved locally).
JIRA_BOARD_ID=
# Optional custom JQL and display label; otherwise use the project's default scope.
JIRA_JQL=
JIRA_SCOPE_NAME=
# Empty restores the saved view. Choices: mine, available, board, backlog.
JIRA_VIEW=
# Optional per-project status-picker order; only reorders existing choices.
# JIRA_STATUS_ORDER='{"DEV":["To Do","In Progress","Code Review","Staging","PO Testing","Production","Done"]}'
JIRA_STATUS_ORDER=

JIRA_BACKEND=auto
JIRA_CLI_BIN=
JIRA_READ_ONLY=false
JIRA_NO_CACHE=false
JIRA_LIMIT=500
# Periodic background refresh and failure retry, each 15..86400 seconds.
JIRA_REFRESH_SECONDS=60
JIRA_REFRESH_RETRY_SECONDS=120
JIRA_ATTACHMENT_DIR=
JIRA_IMAGE_PROTOCOL=auto
JIRA_NO_IMAGES=false
JIRA_NO_COPY_ON_CLICK=false
